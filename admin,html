<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - TikTokShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#FE2C55',
                        primaryHover: '#E01E43'
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans antialiased">

    <!-- VIEW LOGIN -->
    <div id="loginView" class="min-h-screen flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-8 relative">
            <a href="index.html" class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500 hover:text-primary mb-6 transition">
                <i class="fa-solid fa-arrow-left"></i> Back ke Toko
            </a>
            <div class="text-center mb-6">
                <div class="w-12 h-12 bg-primary/10 text-primary rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h1 class="text-xl font-bold">Login Admin</h1>
                <p class="text-xs text-gray-400 mt-1">Masuk untuk mengelola toko online kamu</p>
            </div>
            <form onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
                    <input type="text" id="loginUser" required placeholder="admin" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:border-primary focus:bg-white outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Password</label>
                    <input type="password" id="loginPass" required placeholder="admin123" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:border-primary focus:bg-white outline-none">
                </div>
                <button type="submit" class="w-full bg-primary hover:bg-primaryHover text-white font-bold py-3 rounded-xl shadow transition text-sm">Masuk Dashboard</button>
            </form>
            <div class="mt-4 text-center text-[11px] text-gray-400">Default: username=admin, password=admin123</div>
        </div>
    </div>

    <!-- VIEW DASHBOARD LAYOUT -->
    <div id="dashboardView" class="min-h-screen flex hidden">
        <!-- Sidebar -->
        <aside class="w-64 bg-white border-r border-gray-200 flex flex-col fixed inset-y-0 z-30">
            <div class="p-4 border-b border-gray-100 flex items-center justify-between">
                <div class="flex items-center gap-2 text-primary font-black text-lg">
                    <i class="fa-solid fa-bag-shopping"></i> ShopTok Admin
                </div>
            </div>
            <nav class="flex-1 p-4 space-y-1.5 overflow-y-auto text-sm font-medium">
                <button onclick="switchTab('dashboard')" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl transition text-gray-600 hover:bg-gray-50"><i class="fa-solid fa-chart-pie w-5"></i> Dashboard</button>
                <button onclick="switchTab('inputProduk')" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl transition text-gray-600 hover:bg-gray-50"><i class="fa-solid fa-square-plus w-5"></i> Input Produk</button>
                <button onclick="switchTab('viewProduk')" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl transition text-gray-600 hover:bg-gray-50"><i class="fa-solid fa-box-open w-5"></i> View Produk</button>
                <button onclick="switchTab('laporan')" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl transition text-gray-600 hover:bg-gray-50"><i class="fa-solid fa-file-lines w-5"></i> Laporan Penjualan</button>
                <button onclick="switchTab('grafik')" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl transition text-gray-600 hover:bg-gray-50"><i class="fa-solid fa-chart-line w-5"></i> Grafik Penjualan</button>
                <button onclick="switchTab('penarikan')" class="nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl transition text-gray-600 hover:bg-gray-50"><i class="fa-solid fa-wallet w-5"></i> Penarikan Saldo</button>
            </nav>
            <div class="p-4 border-t border-gray-100">
                <button onclick="handleLogout()" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-xl text-red-500 hover:bg-red-50 font-medium text-sm transition"><i class="fa-solid fa-right-from-bracket w-5"></i> Logout</button>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-1 ml-64 flex flex-col min-w-0">
            <!-- Header Top -->
            <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6 sticky top-0 z-20">
                <h2 id="pageTitle" class="font-bold text-lg text-gray-800">Dashboard</h2>
                <a href="index.html" class="text-xs font-semibold text-primary border border-primary/30 hover:bg-primary/5 px-3 py-1.5 rounded-lg transition">Lihat Toko</a>
            </header>

            <!-- Content Container -->
            <main class="p-6 flex-1 overflow-y-auto">

                <!-- 1. TAB DASHBOARD -->
                <div id="tab-dashboard" class="tab-content space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
                            <div class="w-12 h-12 bg-blue-50 text-blue-500 rounded-xl flex items-center justify-center text-lg"><i class="fa-solid fa-boxes-stacked"></i></div>
                            <div>
                                <div class="text-xs text-gray-400 font-medium">Total Produk</div>
                                <div id="statTotalProduk" class="text-xl font-bold mt-0.5">0</div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
                            <div class="w-12 h-12 bg-amber-50 text-amber-500 rounded-xl flex items-center justify-center text-lg"><i class="fa-solid fa-receipt"></i></div>
                            <div>
                                <div class="text-xs text-gray-400 font-medium">Total Transaksi</div>
                                <div id="statTotalTransaksi" class="text-xl font-bold mt-0.5">0</div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
                            <div class="w-12 h-12 bg-emerald-50 text-emerald-500 rounded-xl flex items-center justify-center text-lg"><i class="fa-solid fa-money-bill-wave"></i></div>
                            <div>
                                <div class="text-xs text-gray-400 font-medium">Total Pendapatan</div>
                                <div id="statTotalPendapatan" class="text-lg font-bold mt-0.5">Rp 0</div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-4">
                            <div class="w-12 h-12 bg-rose-50 text-primary rounded-xl flex items-center justify-center text-lg"><i class="fa-solid fa-wallet"></i></div>
                            <div>
                                <div class="text-xs text-gray-400 font-medium">Saldo Toko Aktif</div>
                                <div id="statSaldoToko" class="text-lg font-bold mt-0.5">Rp 0</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. TAB INPUT PRODUK -->
                <div id="tab-inputProduk" class="tab-content hidden">
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 max-w-2xl">
                        <h3 id="formTitle" class="font-bold text-base mb-4">Tambah Produk Baru</h3>
                        <form onsubmit="handleSaveProduct(event)" class="space-y-4">
                            <input type="hidden" id="editIndex" value="">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Produk</label>
                                <input type="text" id="prodNama" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:border-primary outline-none">
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Harga (Rp)</label>
                                    <input type="number" id="prodHarga" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:border-primary outline-none">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Stok</label>
                                    <input type="number" id="prodStok" required class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:border-primary outline-none">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1">Kategori</label>
                                <select id="prodKategori" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:border-primary outline-none">
                                    <option value="Fashion">Fashion</option>
                                    <option value="Elektronik">Elektronik</option>
                                    <option value="Kecantikan">Kecantikan</option>
                                    <option value="Kuliner">Kuliner</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1">URL Gambar</label>
                                <input type="url" id="prodGambar" required placeholder="https://..." class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:border-primary outline-none">
                            </div>
                            <div class="flex gap-2">
                                <button type="submit" class="bg-primary hover:bg-primaryHover text-white font-bold px-6 py-2.5 rounded-xl text-sm transition">Simpan Produk</button>
                                <button type="button" onclick="resetProductForm()" class="bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold px-4 py-2.5 rounded-xl text-sm transition">Reset</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- 3. TAB VIEW PRODUK -->
                <div id="tab-viewProduk" class="tab-content hidden">
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse text-sm">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-400 text-xs uppercase tracking-wider">
                                        <th class="p-4">Produk</th>
                                        <th class="p-4">Kategori</th>
                                        <th class="p-4">Harga</th>
                                        <th class="p-4">Stok</th>
                                        <th class="p-4 text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="adminProductTable" class="divide-y divide-gray-100"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 4. TAB LAPORAN PENJUALAN -->
                <div id="tab-laporan" class="tab-content hidden space-y-4">
                    <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex items-center gap-3">
                        <span class="text-xs font-semibold text-gray-500">Filter Tanggal:</span>
                        <input type="date" id="filterTanggal" onchange="renderLaporan()" class="bg-gray-50 border border-gray-200 rounded-xl px-3 py-1.5 text-xs outline-none focus:border-primary">
                        <button onclick="document.getElementById('filterTanggal').value=''; renderLaporan();" class="text-xs text-primary font-bold hover:underline">Reset</button>
                    </div>
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse text-sm">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-400 text-xs uppercase tracking-wider">
                                        <th class="p-4">ID Transaksi</th>
                                        <th class="p-4">Tanggal</th>
                                        <th class="p-4">Jumlah Item</th>
                                        <th class="p-4">Total Pendapatan</th>
                                    </tr>
                                </thead>
                                <tbody id="adminTransactionTable" class="divide-y divide-gray-100"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 5. TAB GRAFIK PENJUALAN -->
                <div id="tab-grafik" class="tab-content hidden grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                        <h3 class="font-bold text-sm mb-4 text-gray-700">Pendapatan 7 Hari Terakhir</h3>
                        <canvas id="lineChart"></canvas>
                    </div>
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                        <h3 class="font-bold text-sm mb-4 text-gray-700">Penjualan per Kategori</h3>
                        <div class="max-w-xs mx-auto"><canvas id="pieChart"></canvas></div>
                    </div>
                </div>

                <!-- 6. TAB PENARIKAN SALDO -->
                <div id="tab-penarikan" class="tab-content hidden space-y-6">
                    <div class="bg-gradient-to-r from-primary to-rose-400 rounded-2xl p-6 text-white shadow-lg max-w-xl">
                        <div class="text-xs uppercase tracking-wider font-semibold opacity-90">Saldo Toko Saat Ini</div>
                        <div id="withdrawCurrentSaldo" class="text-3xl font-black mt-1">Rp 0</div>
                    </div>
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 max-w-xl">
                        <h3 class="font-bold text-base mb-4">Form Penarikan Penghasilan</h3>
                        <form onsubmit="handleWithdraw(event)" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1">Jumlah Penarikan (Rp)</label>
                                <input type="number" id="withdrawAmount" required min="10000" class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:border-primary outline-none" placeholder="Minimal Rp 10.000">
                            </div>
                            <button type="submit" class="bg-primary hover:bg-primaryHover text-white font-bold px-6 py-2.5 rounded-xl text-sm transition">Ajukan Tarik</button>
                        </form>
                    </div>
                    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
                        <div class="p-4 border-b border-gray-100 font-bold text-sm">Riwayat Penarikan Saldo</div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse text-sm">
                                <thead>
                                    <tr class="bg-gray-50 border-b border-gray-100 text-gray-400 text-xs uppercase tracking-wider">
                                        <th class="p-4">Tanggal</th>
                                        <th class="p-4">Jumlah</th>
                                        <th class="p-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="withdrawTable" class="divide-y divide-gray-100"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <!-- SCRIPT ADMIN -->
    <script>
        let lineChartInstance = null;
        let pieChartInstance = null;

        // Cek Sesi Login saat Load
        window.addEventListener('DOMContentLoaded', () => {
            if (sessionStorage.getItem('admin_logged') === 'true') {
                showDashboard();
            } else {
                showLogin();
            }
        });

        function handleLogin(e) {
            e.preventDefault();
            let u = document.getElementById('loginUser').value;
            let p = document.getElementById('loginPass').value;
            if (u === 'admin' && p === 'admin123') {
                sessionStorage.setItem('admin_logged', 'true');
                showDashboard();
            } else {
                alert('Username atau Password salah!');
            }
        }

        function handleLogout() {
            sessionStorage.removeItem('admin_logged');
            showLogin();
        }

        function showLogin() {
            document.getElementById('loginView').classList.remove('hidden');
            document.getElementById('dashboardView').classList.add('hidden');
        }

        function showDashboard() {
            document.getElementById('loginView').classList.add('hidden');
            document.getElementById('dashboardView').classList.remove('hidden');
            switchTab('dashboard');
        }

        // Navigasi Tab
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.className = "nav-btn w-full flex items-center gap-3 px-4 py-2.5 rounded-xl transition text-gray-600 hover:bg-gray-50";
            });
            event?.currentTarget?.classList.add('bg-primary/10', 'text-primary', 'font-bold');

            const titles = {
                dashboard: 'Dashboard Overview',
                inputProduk: 'Input / Edit Produk',
                viewProduk: 'Manajemen Produk',
                laporan: 'Laporan Penjualan',
                grafik: 'Grafik Analitik Penjualan',
                penarikan: 'Penarikan Saldo Toko'
            };
            document.getElementById('pageTitle').innerText = titles[tabId];

            // Trigger Load Data per Tab
            if (tabId === 'dashboard') loadDashboardStats();
            if (tabId === 'viewProduk') renderAdminProducts();
            if (tabId === 'laporan') renderLaporan();
            if (tabId === 'grafik') renderCharts();
            if (tabId === 'penarikan') loadWithdrawData();
        }

        // 1. DASHBOARD STATS
        function loadDashboardStats() {
            let products = JSON.parse(localStorage.getItem('db_produk')) || [];
            let transactions = JSON.parse(localStorage.getItem('db_transaksi')) || [];
            let saldo = JSON.parse(localStorage.getItem('db_saldo')) || 0;

            let totalPendapatan = transactions.reduce((sum, t) => sum + t.total, 0);

            document.getElementById('statTotalProduk').innerText = products.length;
            document.getElementById('statTotalTransaksi').innerText = transactions.length;
            document.getElementById('statTotalPendapatan').innerText = `Rp ${totalPendapatan.toLocaleString('id-ID')}`;
            document.getElementById('statSaldoToko').innerText = `Rp ${saldo.toLocaleString('id-ID')}`;
        }

        // 2 & 3. PRODUK CRUD
        function handleSaveProduct(e) {
            e.preventDefault();
            let index = document.getElementById('editIndex').value;
            let products = JSON.parse(localStorage.getItem('db_produk')) || [];

            let newProd = {
                id: index === '' ? Date.now() : products[index].id,
                nama: document.getElementById('prodNama').value,
                harga: Number(document.getElementById('prodHarga').value),
                stok: Number(document.getElementById('prodStok').value),
                kategori: document.getElementById('prodKategori').value,
                gambar: document.getElementById('prodGambar').value
            };

            if (index === '') {
                products.push(newProd);
            } else {
                products[index] = newProd;
            }

            localStorage.setItem('db_produk', JSON.stringify(products));
            alert('Produk berhasil disimpan!');
            resetProductForm();
            switchTab('viewProduk');
        }

        function resetProductForm() {
            document.getElementById('editIndex').value = '';
            document.getElementById('formTitle').innerText = 'Tambah Produk Baru';
            document.querySelector('#tab-inputProduk form').reset();
        }

        function renderAdminProducts() {
            let products = JSON.parse(localStorage.getItem('db_produk')) || [];
            let table = document.getElementById('adminProductTable');
            table.innerHTML = '';

            if (products.length === 0) {
                table.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-gray-400 text-sm">Belum ada produk</td></tr>`;
                return;
            }

            products.forEach((p, idx) => {
                table.innerHTML += `
                    <tr class="hover:bg-gray-50 transition">
                        <td class="p-4 flex items-center gap-3">
                            <img src="${p.gambar}" class="w-10 h-10 object-cover rounded-lg border border-gray-100">
                            <span class="font-medium text-gray-800 line-clamp-1">${p.nama}</span>
                        </td>
                        <td class="p-4 text-gray-600">${p.kategori}</td>
                        <td class="p-4 font-semibold text-primary">Rp ${p.harga.toLocaleString('id-ID')}</td>
                        <td class="p-4 text-gray-600">${p.stok}</td>
                        <td class="p-4 text-center space-x-2">
                            <button onclick="editProduct(${idx})" class="text-blue-500 hover:text-blue-700 font-medium text-xs"><i class="fa-solid fa-pen-to-square"></i></button>
                            <button onclick="deleteProduct(${idx})" class="text-red-500 hover:text-red-700 font-medium text-xs"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            });
        }

        function editProduct(idx) {
            let products = JSON.parse(localStorage.getItem('db_produk'));
            let p = products[idx];

            document.getElementById('editIndex').value = idx;
            document.getElementById('formTitle').innerText = 'Edit Produk';
            document.getElementById('prodNama').value = p.nama;
            document.getElementById('prodHarga').value = p.harga;
            document.getElementById('prodStok').value = p.stok;
            document.getElementById('prodKategori').value = p.kategori;
            document.getElementById('prodGambar').value = p.gambar;

            switchTab('inputProduk');
        }

        function deleteProduct(idx) {
            if (confirm('Yakin ingin menghapus produk ini?')) {
                let products = JSON.parse(localStorage.getItem('db_produk'));
                products.splice(idx, 1);
                localStorage.setItem('db_produk', JSON.stringify(products));
                renderAdminProducts();
            }
        }

        // 4. LAPORAN PENJUALAN
        function renderLaporan() {
            let transactions = JSON.parse(localStorage.getItem('db_transaksi')) || [];
            let filterDate = document.getElementById('filterTanggal').value;
            let table = document.getElementById('adminTransactionTable');
            table.innerHTML = '';

            let filtered = transactions.filter(t => {
                if (!filterDate) return true;
                return t.tanggal === filterDate;
            });

            if (filtered.length === 0) {
                table.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-gray-400 text-sm">Tidak ada transaksi</td></tr>`;
                return;
            }

            filtered.forEach(t => {
                table.innerHTML += `
                    <tr class="hover:bg-gray-50 transition">
                        <td class="p-4 font-mono text-xs font-bold text-gray-600">${t.id}</td>
                        <td class="p-4 text-gray-600">${t.tanggal}</td>
                        <td class="p-4 text-gray-600">${t.jumlahItem} item</td>
                        <td class="p-4 font-bold text-primary">Rp ${t.total.toLocaleString('id-ID')}</td>
                    </tr>
                `;
            });
        }

        // 5. GRAFIK PENJUALAN
        function renderCharts() {
            let transactions = JSON.parse(localStorage.getItem('db_transaksi')) || [];

            // 7 Hari Terakhir
            let labels = [];
            let dataValues = [];
            for (let i = 6; i >= 0; i--) {
                let d = new Date();
                d.setDate(d.getDate() - i);
                let dateStr = d.toISOString().split('T')[0];
                labels.push(dateStr.slice(5));

                let totalDay = transactions.filter(t => t.tanggal === dateStr).reduce((sum, t) => sum + t.total, 0);
                dataValues.push(totalDay);
            }

            if (lineChartInstance) lineChartInstance.destroy();
            const ctxLine = document.getElementById('lineChart').getContext('2d');
            lineChartInstance = new Chart(ctxLine, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Pendapatan (Rp)',
                        data: dataValues,
                        borderColor: '#FE2C55',
                        backgroundColor: 'rgba(254, 44, 85, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: { responsive: true, plugins: { legend: { display: false } } }
            });

            // Pie Chart Kategori
            let categories = ['Fashion', 'Elektronik', 'Kecantikan', 'Kuliner'];
            let catData = categories.map(cat => {
                let totalCat = 0;
                transactions.forEach(t => {
                    t.items.forEach(item => {
                        // Cek kategori produk terkait
                        let products = JSON.parse(localStorage.getItem('db_produk')) || [];
                        let p = products.find(prod => prod.id === item.id);
                        if (p && p.kategori === cat) {
                            totalCat += item.harga * item.qty;
                        }
                    });
                });
                return totalCat;
            });

            if (pieChartInstance) pieChartInstance.destroy();
            const ctxPie = document.getElementById('pieChart').getContext('2d');
            pieChartInstance = new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: categories,
                    datasets: [{
                        data: catData,
                        backgroundColor: ['#FE2C55', '#3B82F6', '#10B981', '#F59E0B']
                    }]
                },
                options: { responsive: true }
            });
        }

        // 6. PENARIKAN SALDO
        function loadWithdrawData() {
            let saldo = JSON.parse(localStorage.getItem('db_saldo')) || 0;
            document.getElementById('withdrawCurrentSaldo').innerText = `Rp ${saldo.toLocaleString('id-ID')}`;

            let withdraws = JSON.parse(localStorage.getItem('db_penarikan')) || [];
            let table = document.getElementById('withdrawTable');
            table.innerHTML = '';

            if (withdraws.length === 0) {
                table.innerHTML = `<tr><td colspan="3" class="p-6 text-center text-gray-400 text-sm">Belum ada riwayat penarikan</td></tr>`;
                return;
            }

            withdraws.forEach(w => {
                table.innerHTML += `
                    <tr class="hover:bg-gray-50 transition">
                        <td class="p-4 text-gray-600">${w.tanggal}</td>
                        <td class="p-4 font-bold text-primary">Rp ${w.jumlah.toLocaleString('id-ID')}</td>
                        <td class="p-4"><span class="bg-amber-100 text-amber-600 text-xs font-bold px-2.5 py-1 rounded-full">${w.status}</span></td>
                    </tr>
                `;
            });
        }

        function handleWithdraw(e) {
            e.preventDefault();
            let amount = Number(document.getElementById('withdrawAmount').value);
            let saldo = JSON.parse(localStorage.getItem('db_saldo')) || 0;

            if (amount > saldo) {
                alert('Jumlah penarikan melebihi saldo saat ini!');
                return;
            }

            saldo -= amount;
            localStorage.setItem('db_saldo', JSON.stringify(saldo));

            let withdraws = JSON.parse(localStorage.getItem('db_penarikan')) || [];
            withdraws.push({
                tanggal: new Date().toISOString().split('T')[0],
                jumlah: amount,
                status: 'Menunggu'
            });
            localStorage.setItem('db_penarikan', JSON.stringify(withdraws));

            alert('Pengajuan penarikan saldo berhasil dikirim!');
            document.getElementById('withdrawAmount').value = '';
            loadWithdrawData();
        }
    </script>
</body>
</html>
