<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - TokoHijau</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        body {
            background-color: #0d0d0d;
            color: #fff;
        }
        .hidden { display: none !important; }
        .overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 99; display: none; }
        .overlay.show { display: block; }
        .sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 240px; background: #1a1a1a; padding-top: 20px; z-index: 100; transform: translateX(-100%); transition: 0.3s; }
        .sidebar.open { transform: translateX(0); }
        .sidebar h2 { text-align: center; color: #ff4d4f; margin-bottom: 20px; font-size: 18px; }
        .sidebar button { display: block; width: 100%; text-align: left; padding: 12px 20px; background: none; border: none; color: #ddd; font-size: 15px; cursor: pointer; }
        .sidebar button:hover, .sidebar button.active { background: #ff4d4f; color: #fff; }
        .header-bar { position: sticky; top: 0; padding: 12px; background: #1a1a1a; display: flex; align-items: center; z-index: 50; }
        .header-bar button { background: none; border: none; color: #fff; font-size: 22px; margin-right: 12px; cursor: pointer; }
        .admin-content { padding: 20px; }
        h2 { font-size: 18px; margin-bottom: 20px; }
        input, textarea { width: 100%; padding: 10px; margin: 6px 0 14px; background: #2a2a2a; border: none; border-radius: 6px; color: #fff; font-size: 14px; }
        label { font-size: 13px; color: #ccc; }
        button.btn { background: #ff4d4f; color: #fff; border: none; padding: 10px 16px; border-radius: 6px; font-weight: 500; cursor: pointer; font-size: 14px; }
        button.btn-outline { background: transparent; border: 1px solid #ff4d4f; color: #ff4d4f; padding: 8px 12px; border-radius: 6px; cursor: pointer; font-size: 13px; }
        .card { background: #1e1e1e; padding: 15px; border-radius: 8px; margin-bottom: 10px; }
        .grid-box { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
        .stat-box { background: #1e1e1e; padding: 15px; border-radius: 8px; text-align: center; }
        .stat-box .angka { font-size: 24px; font-weight: bold; color: #ff4d4f; }
    </style>
</head>
<body>

<!-- Overlay -->
<div class="overlay" id="overlay" onclick="closeSidebar()"></div>

<!-- ================================== HALAMAN LOGIN ADMIN ================================== -->
<div id="page-login" class="admin-content" style="max-width:400px; margin:60px auto;">
    <h2 class="text-center text-xl mb-6">🔐 Login Admin</h2>
    <label>Nama Pengguna</label>
    <input type="text" id="admin-user" placeholder="Masukkan nama pengguna">
    <label>Kata Sandi</label>
    <input type="password" id="admin-pass" placeholder="Masukkan kata sandi">
    <button class="btn w-full mt-2" onclick="loginAdmin()">Masuk ke Panel</button>
    <p class="text-center text-gray-400 text-sm mt-3">Bawaan: admin / admin123</p>
</div>

<!-- ================================== HALAMAN PANEL ADMIN ================================== -->
<div id="page-admin" class="hidden">
    <!-- Sidebar Menu -->
    <div class="sidebar" id="sidebar">
        <h2>⚙️ PANEL ADMIN</h2>
        <button class="menu-item active" data-page="dashboard" onclick="showAdminPage('dashboard')">📊 Dashboard</button>
        <button class="menu-item" data-page="input-barang" onclick="showAdminPage('input-barang')">➕ Input Barang</button>
        <button class="menu-item" data-page="view-barang" onclick="showAdminPage('view-barang')">📦 Lihat Barang</button>
        <button class="menu-item" data-page="laporan-harian" onclick="showAdminPage('laporan-harian')">📄 Laporan Harian</button>
        <button class="menu-item" data-page="laporan-bulanan" onclick="showAdminPage('laporan-bulanan')">📄 Laporan Bulanan</button>
        <button class="menu-item" data-page="laporan-tahunan" onclick="showAdminPage('laporan-tahunan')">📄 Laporan Tahunan</button>
        <button class="menu-item" style="color:#ff8888; margin-top:20px;" onclick="logoutAdmin()">🚪 Keluar</button>
    </div>

    <!-- Atas Bar -->
    <div class="header-bar">
        <button onclick="toggleSidebar()">☰</button>
        <h1 class="font-bold">Panel Admin TokoHijau</h1>
    </div>

    <!-- Isi Halaman Admin -->
    <div class="admin-content">
        <!-- Dashboard -->
        <div id="admin-dashboard" class="admin-page">
            <h2>📊 Ringkasan Penjualan</h2>
            <div class="grid-box">
                <div class="stat-box">
                    <p class="text-sm text-gray-400">Total Produk</p>
                    <p class="angka" id="jml-produk">0</p>
                </div>
                <div class="stat-box">
                    <p class="text-sm text-gray-400">Total Pesanan</p>
                    <p class="angka" id="jml-pesanan">0</p>
                </div>
            </div>
            <button class="btn w-full mt-4" onclick="goToHome()">🏠 Buka Halaman Toko</button>
        </div>

        <!-- Input Barang -->
        <div id="admin-input-barang" class="admin-page hidden">
            <h2>➕ Tambah / Ubah Barang</h2>
            <input type="hidden" id="edit-id">
            <label>Nama Produk *</label>
            <input type="text" id="prod-nama" placeholder="Contoh: Kaos Polos">
            <label>Harga Asli (Rp) *</label>
            <input type="number" id="prod-harga" placeholder="Contoh: 100000">
            <label>Harga Promo (Rp) — kosongkan jika tidak diskon</label>
            <input type="number" id="prod-promo" placeholder="Contoh: 75000">
            <label>Pilihan Ukuran — pisahkan dengan koma</label>
            <input type="text" id="prod-ukuran" placeholder="Contoh: S, M, L, XL">
            <label>Pilihan Warna — pisahkan dengan koma</label>
            <input type="text" id="prod-warna" placeholder="Contoh: Hitam, Putih, Merah">
            <label>Deskripsi Produk</label>
            <textarea id="prod-desk" rows="4" placeholder="Tulis deskripsi produk..."></textarea>
            <button class="btn w-full mt-2" onclick="simpanProduk()">💾 Simpan Produk</button>
        </div>

        <!-- Lihat Barang -->
        <div id="admin-view-barang" class="admin-page hidden">
            <h2>📦 Daftar Semua Barang</h2>
            <div id="daftar-produk"></div>
        </div>

        <!-- Laporan -->
        <div id="admin-laporan-harian" class="admin-page hidden">
            <h2>📄 Laporan Penjualan Harian</h2>
            <p class="text-gray-400">Data penjualan hari ini akan muncul di sini.</p>
        </div>
        <div id="admin-laporan-bulanan" class="admin-page hidden">
            <h2>📄 Laporan Penjualan Bulanan</h2>
            <p class="text-gray-400">Data penjualan bulan ini akan muncul di sini.</p>
        </div>
        <div id="admin-laporan-tahunan" class="admin-page hidden">
            <h2>📄 Laporan Penjualan Tahunan</h2>
            <p class="text-gray-400">Data penjualan tahun ini akan muncul di sini.</p>
        </div>
    </div>
</div>

<script>
// === DATA PRODUK & KERANJANG ===
function bacaProduk() {
    return JSON.parse(localStorage.getItem('produk_data')) || [
        { id:1, nama:"Kaos Polos", harga:100000, promo:75000, ukuran:"S,M,L,XL", warna:"Hitam,Putih,Merah", desk:"Kaos polos bahan katun nyaman dipakai sehari-hari." },
        { id:2, nama:"Celana Jeans", harga:250000, promo:190000, ukuran:"28,29,30,31,32", warna:"Biru Tua,Biru Muda,Hitam", desk:"Celana jeans berkualitas, awet dan nyaman dipakai." },
        { id:3, nama:"Topi Baseball", harga:80000, promo:0, ukuran:"Sekali Ukuran", warna:"Hitam,Putih,Merah", desk:"Topi baseball nyaman dipakai, melindungi dari matahari." }
    ];
}
function simpanProdukKePenyimpanan(data) {
    localStorage.setItem('produk_data', JSON.stringify(data));
}
function bacaKeranjang() {
    return JSON.parse(localStorage.getItem('keranjang_data')) || [];
}

// === LOGIN ADMIN ===
function loginAdmin(){
    let u = document.getElementById('admin-user').value.trim();
    let p = document.getElementById('admin-pass').value.trim();
    if(u==='admin' && p==='admin123'){
        document.getElementById('page-login').classList.add('hidden');
        document.getElementById('page-admin').classList.remove('hidden');
        tampilkanDashboard();
    }else{
        alert('❌ Nama pengguna atau kata sandi salah!');
    }
}
function logoutAdmin(){
    document.getElementById('page-admin').classList.add('hidden');
    document.getElementById('page-login').classList.remove('hidden');
    closeSidebar();
}

// === SIDEBAR ===
function toggleSidebar(){
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('overlay').classList.toggle('show');
}
function closeSidebar(){
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('overlay').classList.remove('show');
}
function showAdminPage(page){
    document.querySelectorAll('.admin-page').forEach(el=>el.classList.add('hidden'));
    document.getElementById('admin-'+page).classList.remove('hidden');
    document.querySelectorAll('.menu-item').forEach(b=>b.classList.remove('active'));
    document.querySelector(`.menu-item[data-page="${page}"]`)?.classList.add('active');
    closeSidebar();
    if(page==='view-barang') tampilkanDaftarProduk();
}

// === DASHBOARD ===
function tampilkanDashboard(){
    let produk = bacaProduk();
    let keranjang = bacaKeranjang();
    document.getElementById('jml-produk').textContent = produk.length;
    document.getElementById('jml-pesanan').textContent = keranjang.length;
}

// === SIMPAN PRODUK ===
function simpanProduk(){
    let id = document.getElementById('edit-id').value;
    let nama = document.getElementById('prod-nama').value.trim();
    let harga = parseInt(document.getElementById('prod-harga').value)||0;
    let promo = parseInt(document.getElementById('prod-promo').value)||0;
    let ukuran = document.getElementById('prod-ukuran').value.trim();
    let warna = document.getElementById('prod-warna').value.trim();
    let desk = document.getElementById('prod-desk').value.trim();

    if(!nama || !harga) return alert('❌ Nama dan harga wajib diisi!');

    let produk = bacaProduk();
    if(id){
        let i = produk.findIndex(p=>p.id==id);
        if(i>=0) produk[i] = {id:parseInt(id), nama, harga, promo, ukuran, warna, desk};
    }else{
        let idBaru = produk.length?Math.max(...produk.map(p=>p.id))+1:1;
        produk.push({id:idBaru, nama, harga, promo, ukuran, warna, desk});
    }

    simpanProdukKePenyimpanan(produk);
    alert('✅ Produk berhasil disimpan!');
    
    // Kosongkan form
    document.getElementById('edit-id').value='';
    document.getElementById('prod-nama').value='';
    document.getElementById('prod-harga').value='';
    document.getElementById('prod-promo').value='';
    document.getElementById('prod-ukuran').value='';
    document.getElementById('prod-warna').value='';
    document.getElementById('prod-desk').value='';

    tampilkanDaftarProduk();
    tampilkanDashboard();
}

// === TAMPILKAN DAFTAR PRODUK ===
function tampilkanDaftarProduk(){
    let produk = bacaProduk();
    let html='';
    produk.forEach(p=>{
        let hargaPromo = p.promo&&p.promo>0?` → <b class="text-red-400">Rp${p.promo.toLocaleString()}</b>`:'';
        html += `
        <div class="card">
            <b>${p.nama}</b><br>
            Harga: Rp${p.harga.toLocaleString()}${hargaPromo}<br>
            <small class="text-gray-400">Ukuran: ${p.ukuran} | Warna: ${p.warna}</small>
            <div class="flex gap-2 mt-2">
                <button class="btn-outline" onclick="ubahProduk(${p.id})">✏️ Ubah</button>
                <button class="btn-outline" onclick="hapusProduk(${p.id})" style="color:#ff6666; border-color:#ff6666;">🗑️ Hapus</button>
            </div>
        </div>`;
    });
    document.getElementById('daftar-produk').innerHTML = html || '<p class="text-gray-400">Belum ada produk, silakan tambahkan.</p>';
}

// === UBAH PRODUK ===
function ubahProduk(id){
    let produk = bacaProduk();
    let p = produk.find(x=>x.id===id);
    if(!p) return;
    document.getElementById('edit-id').value = p.id;
    document.getElementById('prod-nama').value = p.nama;
    document.getElementById('prod-harga').value = p.harga;
    document.getElementById('prod-promo').value = p.promo||'';
    document.getElementById('prod-ukuran').value = p.ukuran;
    document.getElementById('prod-warna').value = p.warna;
    document.getElementById('prod-desk').value = p.desk;
    showAdminPage('input-barang');
}

// === HAPUS PRODUK ===
function hapusProduk(id){
    if(confirm('⚠️ Yakin ingin menghapus produk ini?')){
        let produk = bacaProduk().filter(p=>p.id!==id);
        simpanProdukKePenyimpanan(produk);
        tampilkanDaftarProduk();
        tampilkanDashboard();
    }
}

// === KEMBALI KE HALAMAN TOKO ===
function goToHome(){
    window.location.href = 'index.html';
}
</script>
</body>
</html>
