<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Panel Admin - Toko Online</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          primary: '#ff2e44',
          secondary: '#ee4d2d',
          dark: '#1a1a1a',
          sidebar: '#242424',
        },
        fontFamily: {
          sans: ['Plus Jakarta Sans', 'sans-serif'],
          sora: ['Sora', 'sans-serif'],
        }
      }
    }
  }
</script>
<style type="text/tailwindcss">
  @layer utilities {
    .sidebar-link {
      @apply flex items-center gap-3 px-4 py-3 rounded-lg transition-all duration-200 hover:bg-primary/20 hover:text-white;
    }
    .sidebar-link.active {
      @apply bg-primary text-white font-medium;
    }
    .card {
      @apply bg-white rounded-xl shadow-md p-4 text-gray-800;
    }
    .btn {
      @apply px-4 py-2 rounded-lg font-medium transition-all;
    }
    .btn-primary {
      @apply bg-primary text-white hover:bg-primary/90;
    }
    .btn-danger {
      @apply bg-red-600 text-white hover:bg-red-700;
    }
    .input-field {
      @apply w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary/50;
    }
  }
</style>
</head>
<body class="bg-gray-100 font-sans">
  <div class="flex h-screen overflow-hidden">
    <!-- SIDEBAR -->
    <aside class="w-64 bg-sidebar text-white flex flex-col fixed md:relative h-full z-30 transition-all" id="sidebar">
      <div class="p-4 border-b border-gray-700">
        <h1 class="font-sora text-xl font-bold text-center text-primary">⚙️ Admin Panel</h1>
        <p class="text-sm text-gray-400 text-center mt-1">Toko Online</p>
      </div>

      <nav class="flex-1 py-4 px-2 space-y-2 overflow-y-auto">
        <a href="#" class="sidebar-link active" onclick="showPage('dashboard')">
          <span>📊</span> Dashboard
        </a>
        <a href="#" class="sidebar-link" onclick="showPage('input-barang')">
          <span>➕</span> Input Barang
        </a>
        <a href="#" class="sidebar-link" onclick="showPage('view-barang')">
          <span>📦</span> View Barang
        </a>
        <a href="#" class="sidebar-link" onclick="showPage('laporan')">
          <span>📈</span> Laporan
        </a>
        <a href="#" class="sidebar-link text-red-400 hover:bg-red-500/20 hover:text-red-300 mt-8" onclick="logout()">
          <span>🚪</span> Logout
        </a>
      </nav>
    </aside>

    <!-- KONTEN UTAMA -->
    <main class="flex-1 overflow-y-auto p-4 md:p-6">
      <!-- HALAMAN DASHBOARD -->
      <section id="page-dashboard" class="page-content">
        <h2 class="text-[clamp(1.2rem,3vw,1.5rem)] font-bold text-gray-800 mb-4">Ringkasan Penjualan</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <div class="card">
            <h3 class="text-gray-500 text-sm">Total Produk</h3>
            <p class="text-2xl font-bold text-secondary" id="total-produk">0</p>
          </div>
          <div class="card">
            <h3 class="text-gray-500 text-sm">Total Penjualan</h3>
            <p class="text-2xl font-bold text-green-600">Rp 0</p>
          </div>
          <div class="card">
            <h3 class="text-gray-500 text-sm">Pesanan Hari Ini</h3>
            <p class="text-2xl font-bold text-blue-600">0</p>
          </div>
          <div class="card">
            <h3 class="text-gray-500 text-sm">Pengunjung</h3>
            <p class="text-2xl font-bold text-orange-500">0</p>
          </div>
        </div>
        <div class="card">
          <h3 class="font-semibold mb-3">Grafik Penjualan</h3>
          <canvas id="salesChart" height="200"></canvas>
        </div>
      </section>

      <!-- HALAMAN INPUT BARANG -->
      <section id="page-input-barang" class="page-content hidden">
        <h2 class="text-[clamp(1.2rem,3vw,1.5rem)] font-bold text-gray-800 mb-4">Tambah / Edit Barang</h2>
        <div class="card max-w-2xl">
          <form id="form-barang" class="space-y-3">
            <input type="hidden" id="edit-id" value="">
            <div>
              <label class="block text-sm font-medium mb-1">Nama Barang</label>
              <input type="text" id="nama" class="input-field" required placeholder="Masukkan nama barang">
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-sm font-medium mb-1">Harga Asli (Rp)</label>
                <input type="number" id="harga-asli" class="input-field" required placeholder="Contoh: 100000">
              </div>
              <div>
                <label class="block text-sm font-medium mb-1">Harga Promo (Rp)</label>
                <input type="number" id="harga-promo" class="input-field" placeholder="Kosongkan jika tidak ada diskon">
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Gambar (URL)</label>
              <input type="url" id="gambar" class="input-field" required placeholder="Link gambar produk">
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Deskripsi</label>
              <textarea id="deskripsi" rows="3" class="input-field" placeholder="Deskripsi lengkap barang"></textarea>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Ukuran Tersedia (pisahkan dengan koma)</label>
              <input type="text" id="ukuran" class="input-field" placeholder="S, M, L, XL">
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Warna Tersedia (pisahkan dengan koma)</label>
              <input type="text" id="warna" class="input-field" placeholder="Merah, Biru, Hitam">
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">Kategori</label>
              <select id="kategori" class="input-field">
                <option value="pakaian">Pakaian</option>
                <option value="elektronik">Elektronik</option>
                <option value="makanan">Makanan</option>
                <option value="lainnya">Lainnya</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary w-full">💾 Simpan Barang</button>
          </form>
        </div>
      </section>

      <!-- HALAMAN VIEW BARANG -->
      <section id="page-view-barang" class="page-content hidden">
        <h2 class="text-[clamp(1.2rem,3vw,1.5rem)] font-bold text-gray-800 mb-4">Daftar Barang</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-white rounded-xl shadow-md">
            <thead class="bg-gray-100 text-left">
              <tr>
                <th class="p-3 text-sm">Gambar</th>
                <th class="p-3 text-sm">Nama</th>
                <th class="p-3 text-sm">Harga</th>
                <th class="p-3 text-sm">Aksi</th>
              </tr>
            </thead>
            <tbody id="daftar-barang">
              <!-- Data dimuat dari JS -->
            </tbody>
          </table>
        </div>
      </section>

      <!-- HALAMAN LAPORAN -->
      <section id="page-laporan" class="page-content hidden">
        <h2 class="text-[clamp(1.2rem,3vw,1.5rem)] font-bold text-gray-800 mb-4">Laporan Penjualan</h2>
        <div class="flex flex-wrap gap-2 mb-4">
          <button class="btn btn-primary" onclick="showLaporan('harian')">Laporan Harian</button>
          <button class="btn btn-primary" onclick="showLaporan('bulanan')">Laporan Bulanan</button>
          <button class="btn btn-primary" onclick="showLaporan('tahunan')">Laporan Tahunan</button>
        </div>
        <div class="card">
          <h3 class="font-semibold mb-3" id="judul-laporan">Pilih Jenis Laporan</h3>
          <div id="isi-laporan" class="space-y-2">
            <p class="text-gray-500">Silakan pilih laporan di atas.</p>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script>
    // === INISIALISASI DATA ===
    let produk = JSON.parse(localStorage.getItem('produk')) || [];
    let salesChart;

    // === TAMPILKAN HALAMAN ===
    function showPage(pageName) {
      document.querySelectorAll('.page-content').forEach(p => p.classList.add('hidden'));
      document.getElementById(`page-${pageName}`).classList.remove('hidden');
      
      document.querySelectorAll('.sidebar-link').forEach(link => link.classList.remove('active'));
      event.target.closest('.sidebar-link')?.classList.add('active');

      if(pageName === 'view-barang') renderDaftarBarang();
      if(pageName === 'dashboard') initDashboard();
    }

    // === FORM INPUT BARANG ===
    document.getElementById('form-barang').addEventListener('submit', (e) => {
      e.preventDefault();
      const id = document.getElementById('edit-id').value;
      const barang = {
        id: id || Date.now().toString(),
        nama: document.getElementById('nama').value,
        hargaAsli: parseInt(document.getElementById('harga-asli').value),
        hargaPromo: parseInt(document.getElementById('harga-promo').value) || 0,
        gambar: document.getElementById('gambar').value,
        deskripsi: document.getElementById('deskripsi').value,
        ukuran: document.getElementById('ukuran').value.split(',').map(s => s.trim()).filter(s=>s),
        warna: document.getElementById('warna').value.split(',').map(s => s.trim()).filter(s=>s),
        kategori: document.getElementById('kategori').value,
        tanggal: new Date().toISOString()
      };

      if(id) {
        const idx = produk.findIndex(b => b.id === id);
        produk[idx] = barang;
      } else {
        produk.push(barang);
      }

      simpanData();
      e.target.reset();
      document.getElementById('edit-id').value = '';
      alert('✅ Barang berhasil disimpan!');
      showPage('view-barang');
    });

    // === SIMPAN KE LOCALSTORAGE ===
    function simpanData() {
      localStorage.setItem('produk', JSON.stringify(produk));
      document.getElementById('total-produk').textContent = produk.length;
    }

    // === RENDER DAFTAR BARANG ===
    function renderDaftarBarang() {
      const tbody = document.getElementById('daftar-barang');
      tbody.innerHTML = '';
      produk.forEach(barang => {
        const tr = document.createElement('tr');
        tr.className = 'border-t';
        tr.innerHTML = `
          <td class="p-2"><img src="${barang.gambar}" class="w-12 h-12 object-cover rounded" alt=""></td>
          <td class="p-2 text-sm">${barang.nama}</td>
          <td class="p-2 text-sm">
            ${barang.hargaPromo ? `<s class="text-red-500 text-xs">Rp${barang.hargaAsli.toLocaleString()}</s> Rp${barang.hargaPromo.toLocaleString()}` : `Rp${barang.hargaAsli.toLocaleString()}`}
          </td>
          <td class="p-2 space-x-1">
            <button class="bg-yellow-500 text-white px-2 py-1 rounded text-xs" onclick="editBarang('${barang.id}')">Edit</button>
            <button class="bg-red-600 text-white px-2 py-1 rounded text-xs" onclick="hapusBarang('${barang.id}')">Hapus</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    // === EDIT & HAPUS BARANG ===
    function editBarang(id) {
      const barang = produk.find(b => b.id === id);
      if(!barang) return;
      showPage('input-barang');
      document.getElementById('edit-id').value = barang.id;
      document.getElementById('nama').value = barang.nama;
      document.getElementById('harga-asli').value = barang.hargaAsli;
      document.getElementById('harga-promo').value = barang.hargaPromo;
      document.getElementById('gambar').value = barang.gambar;
      document.getElementById('deskripsi').value = barang.deskripsi;
      document.getElementById('ukuran').value = barang.ukuran.join(', ');
      document.getElementById('warna').value = barang.warna.join(', ');
      document.getElementById('kategori').value = barang.kategori;
    }
    function hapusBarang(id) {
      if(confirm('Yakin hapus barang ini?')) {
        produk = produk.filter(b => b.id !== id);
        simpanData();
        renderDaftarBarang();
      }
    }

    // === DASHBOARD ===
    function initDashboard() {
      document.getElementById('total-produk').textContent = produk.length;
      const ctx = document.getElementById('salesChart').getContext('2d');
      if(salesChart) salesChart.destroy();
      salesChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu','Minggu'],
          datasets: [{
            label: 'Penjualan',
            data: [12,19,8,15,22,30,10],
            backgroundColor: '#ff2e4480'
          }]
        }
      });
    }

    // === LAPORAN ===
    function showLaporan(jenis) {
      const judul = document.getElementById('judul-laporan');
      const isi = document.getElementById('isi-laporan');
      let teks = '';
      if(jenis === 'harian') {
        judul.textContent = '📅 Laporan Harian';
        teks = `
          <p><strong>Tanggal:</strong> ${new Date().toLocaleDateString('id-ID')}</p>
          <p>Barang terjual: 5</p>
          <p>Total Pendapatan: Rp 450.000</p>
        `;
      } else if(jenis === 'bulanan') {
        judul.textContent = '📆 Laporan Bulanan';
        teks = `
          <p><strong>Bulan:</strong> ${new Date().toLocaleString('id-ID',{month:'long',year:'numeric'})}</p>
          <p>Barang terjual: 150</p>
          <p>Total Pendapatan: Rp 12.500.000</p>
        `;
      } else {
        judul.textContent = '🗓️ Laporan Tahunan';
        teks = `
          <p><strong>Tahun:</strong> ${new Date().getFullYear()}</p>
          <p>Barang terjual: 1.800</p>
          <p>Total Pendapatan: Rp 150.000.000</p>
        `;
      }
      isi.innerHTML = teks;
    }

    // === LOGOUT ===
    function logout() {
      if(confirm('Yakin ingin keluar?')) {
        window.location.href = 'index.html';
      }
    }

    // === SAAT DIBUKA ===
    document.addEventListener('DOMContentLoaded', () => {
      simpanData();
    });
  </script>
</body>
</html>
